# Copy this file to .env and adjust the values for your machine.
# The server also runs without .env using the development defaults below.

PORT=3000
# :: listens on both IPv6 and IPv4. Use 127.0.0.1 to restrict access to this
# computer only, or 0.0.0.0 for IPv4-only access from the local network.
HOST=::
NODE_ENV=development

# Used the first time the database is seeded. Changing it later does not
# overwrite the stored password hash — update the password from the studio UI.
ADMIN_USER=admin
ADMIN_PASSWORD=Sanoj@2026

# A long random string used to sign admin session cookies.
# If omitted, a secret is generated in data/.session-secret on first run.
SESSION_SECRET=replace-this-with-a-long-random-string

STORE_NAME=Sanoj Type Foundry
